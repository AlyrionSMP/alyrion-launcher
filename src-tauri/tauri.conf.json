{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alyrion Launcher",
  "version": "1.0.0",
  "identifier": "com.alyrion.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Alyrion Launcher",
        "label": "main",
        "width": 1120,
        "height": 720,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#0e1013"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false,
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Launcher for the Alyrion VII modpack",
    "longDescription": "Alyrion Launcher is the official launcher for the Alyrion VII Minecraft modpack. It installs, auto-updates and launches the exact latest version of the pack — nothing else.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["en-US"]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.1-0",
          "libsoup-3.0-0",
          "libjavascriptcoregtk-4.1-0"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}